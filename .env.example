# Copy to .env (git-ignored) and put your DagsHub token in place of the placeholder.
# Used via:  uv run --env-file .env python -m riskflux.registry.log_run
MLFLOW_TRACKING_URI=https://dagshub.com/riyansh100/riskflux.mlflow
MLFLOW_TRACKING_USERNAME=riyansh100
MLFLOW_TRACKING_PASSWORD=<your DagsHub token>
MLFLOW_DISABLE_AGENT_HINT=1
