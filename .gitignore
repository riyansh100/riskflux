# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling caches
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Secrets — never commit
.env
kaggle.json

# Data safety net: large data files belong in DVC, never git
*.csv
*.csv.gz
*.zip
*.parquet
# ...except small committed reports (DVC metrics/plots with cache: false)
!reports/*.csv

# MLflow local artifacts
mlruns/
mlartifacts/

# OS / editor
.DS_Store
.vscode/
.idea/

# Drift HTML reports: large, regenerated by the monitoring job
reports/drift/*.html

# API prediction logs: operational data (regenerable by replaying traffic), never committed
*.jsonl
